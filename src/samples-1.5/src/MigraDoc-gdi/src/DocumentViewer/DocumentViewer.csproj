<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(PDFsharpBuildFewerFrameworks)'=='true'">
    <IsProjectBuildable>false</IsProjectBuildable>
  </PropertyGroup>

  <Target Name="CheckIfBuildable" BeforeTargets="BeforeBuild">
    <Message Text="Skipping build for $(MSBuildProjectName)" Importance="High" Condition="'$(IsProjectBuildable)' == 'false'" />
    <Error Text="Skipping build. Project does not support .NET 6/8 yet." Condition="'$(IsProjectBuildable)' == 'false'" />
  </Target>

  <PropertyGroup>
    <TargetFrameworks>$(PDFsharpTargetFrameworks_Windows)</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <DefineConstants>GDI</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>True</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Charts.cs" Link="HelloMigraDoc\Charts.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Cover.cs" Link="HelloMigraDoc\Cover.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Documents.cs" Link="HelloMigraDoc\Documents.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\FillerText.cs" Link="HelloMigraDoc\FillerText.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Paragraphs.cs" Link="HelloMigraDoc\Paragraphs.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Styles.cs" Link="HelloMigraDoc\Styles.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\TableOfContents.cs" Link="HelloMigraDoc\TableOfContents.cs" />
    <Compile Include="..\..\..\..\..\samples\src\MigraDoc\src\HelloMigraDoc\Tables.cs" Link="HelloMigraDoc\Tables.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PDFsharpBuildFewerFrameworks)'!='true'">
    <PackageReference Include="$(PDFsharp_PSGDI_PackageName)" />
    <PackageReference Include="$(PDFsharp_PSMDGDI_PackageName)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="HelloMigraDoc\" />
  </ItemGroup>

</Project>
